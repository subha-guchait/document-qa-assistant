APP_PORT=8080

POSTGRES_HOST_PORT=5433
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

DB_URL=jdbc:postgresql://localhost:5433/your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

STORAGE_PATH=./uploads

# Embedding provider: gemini | openai | ollama | grok
AI_PROVIDER=gemini

# Gemini (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI (required when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com

# Ollama (required when AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# xAI / Grok (required when AI_PROVIDER=grok)
# XAI_API_KEY=your_xai_api_key