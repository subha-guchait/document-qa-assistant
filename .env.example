APP_PORT=8080

POSTGRES_HOST_PORT=5433
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

DB_URL=jdbc:postgresql://localhost:5433/your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

STORAGE_PATH=./uploads

# Embedding AI provider: gemini | openai | ollama | grok
EMBEDDING_AI_PROVIDER=gemini
# Chat AI provider: gemini | openai | ollama | grok
CHAT_AI_PROVIDER=gemini

# Gemini (required when EMBEDDING_AI_PROVIDER=gemini or CHAT_AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# OpenAI (required when EMBEDDING_AI_PROVIDER=openai or CHAT_AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Ollama (required when EMBEDDING_AI_PROVIDER=ollama or CHAT_AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.2

# xAI / Grok (required when EMBEDDING_AI_PROVIDER=grok or CHAT_AI_PROVIDER=grok)
# XAI_API_KEY=your_xai_api_key